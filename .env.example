# ── 必填：MongoDB 连接（网站导航 / 各类数据持久化）──
# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略，切勿提交。
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# 可选：显式指定库名，缺省落到 "tools"
MONGODB_DB_NAME="tools"

# ── 必填：后台管理密码（分类/链接增删改、seed 导入）──
ADMIN_PASSWORD="change-me"

# ── 可选：DNS 探测（Cloudflare）──
CF_API_TOKEN=""
CF_ZONE_IDS=""

# ── 可选：GitHub（仓库列表 / 创作者）──
# 不配也能用（匿名请求 60 次/小时）；配 token 可读私有仓库并放宽限流
GH_TOKEN=""
GH_USERNAME=""

# ── 可选：全局 AI 代理（服务端代发 AI 请求；缺省回退环境变量）──
GLOBAL_AI_BASE_URL=""
GLOBAL_AI_API_KEY=""
GLOBAL_AI_MODEL="gpt-4o-mini"
